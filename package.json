  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "update-deps": "npm update",
    "clean": "expo start -c",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
